<?xml version="1.0" encoding="utf-8"?>


<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="56dp"

    xmlns:android="http://schemas.android.com/apk/res/android">


    <TextView
        android:id="@+id/textView2"
        android:layout_width="313dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="Let's make"
        android:textColor="@color/black"
        android:textSize="48sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:fontFamily="sans-serif"
        android:textStyle="italic"
        android:textSize="48sp"
        android:textColor="@color/black"
        android:text="your days" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:fontFamily="sans-serif"
        android:textStyle="bold"
        android:textSize="48sp"
        android:textColor="@color/black"
        android:text="healthier" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No rushing.Only our feelings."
        android:gravity="center"
        android:fontFamily="sans-serif"
        android:textSize="15sp"
        android:textColor="@color/black"/>

        <!--  the rond borders -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:id="@+id/textView6"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_dashed"
                android:gravity="center"
                android:text="🍏"
                android:textSize="20sp" />

            <View
                android:id="@+id/view"
                android:layout_width="20dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/textView7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_dashed"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:text="Track meals mindfully"
                android:textColor="#333333" />

            <View
                android:id="@+id/view2"
                android:layout_width="15dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/textView8"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_dashed"
                android:gravity="center"
                android:text="🥕"
                android:textSize="20sp" />

        </LinearLayout>




    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/textView9"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_dashed"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp"
            android:text="Support energy"
            android:textColor="#333333" />


        <View
            android:id="@+id/view3"
            android:layout_width="20dp"
            android:layout_height="1dp" />
        <TextView
            android:id="@+id/textView10"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_dashed"
            android:gravity="center"
            android:text="🍏"
            android:textSize="20sp" />

        <View
            android:id="@+id/view4"
            android:layout_width="15dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/textView11"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_dashed"
            android:gravity="center"
            android:text="🥕"
            android:textSize="20sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/textView12"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_dashed"
            android:gravity="center"
            android:text="🍏"
            android:textSize="20sp" />

        <View
            android:id="@+id/view5"
            android:layout_width="10dp"
            android:layout_height="1dp" />


        <TextView
            android:id="@+id/textView13"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_dashed"
            android:gravity="center"
            android:text="🥕"
            android:textSize="20sp" />
        <View
            android:id="@+id/view6"
            android:layout_width="10dp"
            android:layout_height="1dp" />
        <TextView
            android:id="@+id/textView14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_dashed"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp"
            android:text="Increase meals Nutrition"
            android:textColor="#333333" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="100dp">
        <TextView
            android:id="@+id/button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_shape"
            android:text="GET STARTED"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/textView15"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Already have an account?"
            android:gravity="center"
            android:textColor="@color/black"
            android:paddingTop="12dp"/>

    </LinearLayout>




</LinearLayout>











